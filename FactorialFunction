let numero = 10 ;
let contador = numero - 1 ;
let acumulador = 1;
let final = 0;

function fatorial (numero) {
    for (; contador > 0 ; contador--) {
        acumulador *= numero ;
        numero-- ;
        final = acumulador
    }
    return final
}

let resposta = fatorial(numero);
console.log(resposta)
